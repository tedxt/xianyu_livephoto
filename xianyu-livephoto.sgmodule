#!name=闲鱼 Live 图静态化
#!desc=通过详情响应脚本和图片 CDN 重定向两种方式，将闲鱼 Live Photo 静态化。
#!author=local

[URL Rewrite]
^https?:\/\/img\.alicdn\.com\/(.*)~livephoto~_(.*)$ https://img.alicdn.com/$1_$2 302

[Script]
闲鱼Live图静态化 = type=http-response, pattern=^https?:\/\/[^\/]+\/(?:h5|gw)\/(?:mtop\.taobao\.idle\.(?:awesome\.detail|item\.info|mach\.item\.service\.faas\.item))\/[^\/]+\/, requires-body=true, max-size=0, binary-body-mode=false, script-path=https://raw.githubusercontent.com/tedxt/xianyu_livephoto/main/xianyu_livephoto.js

[MITM]
hostname = %APPEND% h5api.m.goofish.com, acs.m.goofish.com, acs.m.taobao.com, rhdc-acs.m.taobao.com, api.goofish.com, img.alicdn.com
